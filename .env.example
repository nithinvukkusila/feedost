# Copy to .env.local and fill in. Never commit real values.

# Supabase (public values, safe in the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# PostHog
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Sentry
NEXT_PUBLIC_SENTRY_DSN=

# Command line only. Never in Vercel. Never in a file on this machine.
# Set these in your shell for one session when a release step needs them.
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=
VERCEL_AUTOMATION_BYPASS_SECRET=

# Function secret, set with `supabase secrets set` per environment (never in a file). Used by waitlist-join to hash IPs.
# WAITLIST_HASH_SALT=
# Function secret for the receipt function (R1-7 B), a different value from the waitlist one. Set with `supabase secrets set`.
# RECEIPT_HASH_SALT=
# Function secret for the pay-page and record-consent functions (R1-9 A), a different value from the other two. Set with `supabase secrets set`.
# PAYPAGE_HASH_SALT=
