{
  "name": "feedost",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/check-build-env.mjs && next build",
    "lint": "eslint . && node scripts/check-tokens.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "size": "node scripts/size.mjs",
    "check:leak": "node scripts/check-locale-leak.mjs",
    "i18n:check": "node scripts/i18n-check.mjs",
    "check:404": "node scripts/check-404.mjs",
    "check:db": "node scripts/check-db.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:build-env": "node scripts/check-build-env.mjs",
    "smoke:env": "node scripts/smoke-env.mjs",
    "fonts:report": "node scripts/font-report.mjs",
    "serve:lan": "HOST=0.0.0.0 PORT=4173 node scripts/serve-out.mjs",
    "db:start": "SUPABASE_NO_UPDATE_CHECK=1 supabase start -x studio,imgproxy,mailpit,logflare,vector,realtime,storage-api,edge-runtime,postgrest,postgres-meta,supavisor",
    "db:stop": "SUPABASE_NO_UPDATE_CHECK=1 supabase stop --no-backup",
    "db:reset": "SUPABASE_NO_UPDATE_CHECK=1 supabase db reset",
    "db:test": "SUPABASE_NO_UPDATE_CHECK=1 supabase test db"
  },
  "dependencies": {
    "@cantoo/fontkit": "2.0.12",
    "@cantoo/pdf-lib": "2.11.1",
    "@supabase/supabase-js": "2.117.3",
    "next": "16.4.0",
    "next-intl": "4.14.7",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@formatjs/icu-messageformat-parser": "3.5.20",
    "@playwright/test": "1.64.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "jsdom": "30.1.2",
    "supabase": "2.118.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  },
  "packageManager": "pnpm@10.34.6"
}
